    <displayOrderInCategory>30</displayOrderInCategory>
    <foodPoisoningChanceFactor>0.9</foodPoisoningChanceFactor>
    <displayCategory MayRequire="Ludeon.RimWorld.Biotech">Archite</displayCategory>
    <customEffectDescriptions>
      <li>Resistance to Kuru disease</li>
    </customEffectDescriptions>
    <statOffsets>
      <ImmunityGainSpeed>1.01</ImmunityGainSpeed>
    </statOffsets>
    <biostatCpx>1</biostatCpx>
    <biostatArc>1</biostatArc>
    <biostatMet>-1</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li>
          <symbol>cani</symbol>
          <symbol>orge</symbol>
        </li>
      </prefixSymbols>
      <suffixSymbols>
        <li>
          <symbol>anth</symbol>
          <symbol>orge</symbol>
        </li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

