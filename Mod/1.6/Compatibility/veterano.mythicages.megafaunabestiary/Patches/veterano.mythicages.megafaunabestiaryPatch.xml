<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="MA_Fatkibble"]/comps</xpath>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="MA_Fatkibble"]/comps</xpath>
            <value>
                <li Class="Kuru.CompFoodKuruCarryingProperties">
                    <compClass>Kuru.CompFoodKuruCarrying</compClass>
                </li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="MA_Fatkibble"]</xpath>
            <value>
                <comps>
                    <li Class="Kuru.CompFoodKuruCarryingProperties">
                        <compClass>Kuru.CompFoodKuruCarrying</compClass>
                    </li>
                </comps>
            </value>
        </nomatch>
    </Operation>

</Patch>